[Unit]
Description=Universal Treble Launcher and Compositor (UTLC)
Documentation=man:utlc(1)

[Service]
Type=notify
ExecStartPre=-/usr/bin/install -d -m 0700 /run/user/0
ExecStart=/usr/bin/utlc --daemon
Restart=always
RestartSec=1
WatchdogSec=30
OOMScoreAdjust=-900
LimitNOFILE=65536
LimitMEMLOCK=infinity
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu:/lib/aarch64-linux-gnu:/usr/lib:/lib
Environment=HOME=/root
Environment=USER=root
Environment=SHELL=/bin/bash
StandardOutput=null
StandardError=null

[Install]
WantedBy=graphical.target
